# forge-free gateway — environment reference
# Copy to .env and fill in the upstream API keys you want to expose.

# --- auth ---
# anonymous  = public relay (default)
# token      = require `Authorization: Bearer $GATEWAY_TOKEN`
GATEWAY_MODE=anonymous
GATEWAY_TOKEN=

# --- listen ---
PORT=8787
HOST=0.0.0.0

# --- limits ---
# SQLite path for daily quota persistence. Must be writable by the gateway.
GATEWAY_QUOTA_DB=./data/quota.sqlite
# Daily token cap per client key (default 1,000,000)
GATEWAY_DAILY_TOKEN_CAP=1000000
# Optional daily cost cap in USD
GATEWAY_DAILY_COST_CAP=
# Requests per minute per client IP (default 60)
GATEWAY_RATE_LIMIT=60

# --- free-tier upstream keys (Phase 30 presets) ---
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=