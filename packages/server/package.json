{
  "name": "@forge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "forge": "./dist/bin/forge.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "lint": "biome check src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge/ai": "workspace:*",
    "@forge/core": "workspace:*",
    "@hono/node-server": "^2.0.0",
    "@hono/zod-openapi": "0.18.1",
    "hono": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@biomejs/biome": "^1.9.0"
  }
}