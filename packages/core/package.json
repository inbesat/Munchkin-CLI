{
  "name": "@forge/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./diff": {
      "import": "./dist/diff/index.js",
      "types": "./dist/diff/index.d.ts"
    },
    "./diff/*": {
      "import": "./dist/diff/*.js",
      "types": "./dist/diff/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge/git": "workspace:*",
    "zod": "^4.4.3",
    "@sinclair/typebox": "^0.34.0",
    "diff": "^7.0.0",
    "shiki": "^2.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.7.0"
  }
}
