---
const demos = [
  {
    src: './demos/help.gif',
    title: 'One binary, every workflow',
    caption: 'forge --help — serve, rpc, auth, worktrees, evals, doctor, update, setup.',
  },
  {
    src: './demos/setup.gif',
    title: 'Onboard in a minute',
    caption: 'forge setup — provider, API key, model, theme, permission mode.',
  },
  {
    src: './demos/doctor.gif',
    title: 'Diagnose the install',
    caption: 'forge doctor — versions, keys, MCP, plugins, config, permissions.',
  },
]

const features = [
  {
    title: 'Event-sourced sessions',
    body: 'One append-only log per session — resume, fork, replay, and full-text search are all derived views of the same stream.',
  },
  {
    title: 'Permission-first tooling',
    body: 'Six permission modes plus layered allow/deny/ask rules. Every tool call passes the engine before it touches your disk.',
  },
  {
    title: 'Provider-agnostic models',
    body: 'Anthropic, OpenAI, and Google wired today; DeepSeek, Ollama, Bedrock, and Vertex adapters share the same config shape.',
  },
  {
    title: 'Plugin everything',
    body: 'Providers, tools, sandboxes, storage, UI hooks — swappable via forge.plugin.json manifests and a bundled marketplace.',
  },
  {
    title: 'MCP native',
    body: 'Attach any MCP server\'s tools as a client, or expose forge itself as an MCP server over stdio (forge rpc).',
  },
  {
    title: 'Server-first API',
    body: 'Hono HTTP server with SSE streaming, OpenAPI spec, and Scalar docs — TypeScript and Python SDKs generated for it.',
  },
  {
    title: 'Git built in',
    body: 'Checkpoints and rewind over the event log, worktree flows (list/create/merge/remove), and GitHub App PR automation.',
  },
  {
    title: 'Evals & observability',
    body: 'SWE-bench-lite runner with regression gating, forge doctor diagnostics, usage stats, and opt-in telemetry.',
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230d1117'/><text x='50' y='72' font-size='62' font-family='monospace' fill='%2379c0ff' text-anchor='middle'>f</text></svg>"
    />
    <title>forge — the open-source CLI coding agent</title>
    <meta
      name="description"
      content="A from-scratch, fully customizable, open-source CLI coding agent: event-sourced sessions, permission-first tooling, provider-agnostic models, plugin everything."
    />
    <style is:global>
      :root {
        --bg: #0d1117;
        --bg2: #101726;
        --fg: #e6edf3;
        --muted: #8b949e;
        --accent: #79c0ff;
        --ok: #3fb950;
        --border: #21262d;
        --card: #161b22;
      }
      * { box-sizing: border-box; }
      html { color-scheme: dark; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', sans-serif;
      }
      .container { max-width: 1080px; margin: 0 auto; padding: 0 1.25rem; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      code, pre {
        font-family: Consolas, 'JetBrains Mono', monospace;
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 8px;
      }
      code { padding: 0.15em 0.4em; font-size: 0.9em; }
      pre { padding: 0.9rem 1.1rem; overflow-x: auto; }
      header.site {
        position: sticky; top: 0; z-index: 10;
        background: rgba(13, 17, 23, 0.9); backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
      }
      header.site .container {
        display: flex; align-items: center; justify-content: space-between;
        padding-top: 0.8rem; padding-bottom: 0.8rem;
      }
      .wordmark { font-weight: 700; font-size: 1.15rem; letter-spacing: 0.02em; }
      .wordmark span { color: var(--accent); }
      nav.links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
      nav.links a { color: var(--fg); opacity: 0.85; }
      nav.links a:hover { opacity: 1; }
      .hero { padding: 4.5rem 0 3rem; text-align: center; }
      .hero h1 { font-size: clamp(2rem, 6vw, 3.25rem); margin: 0 0 0.75rem; line-height: 1.15; }
      .hero h1 em { font-style: normal; color: var(--accent); }
      .hero p.tagline {
        color: var(--muted); font-size: 1.1rem; max-width: 46rem;
        margin: 0 auto 1.75rem;
      }
      .cta-row { display: flex; gap: 0.85rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.25rem; }
      .btn {
        display: inline-block; padding: 0.65rem 1.35rem; border-radius: 10px;
        font-weight: 600; border: 1px solid var(--border);
      }
      .btn.primary { background: var(--accent); color: #0d1117; border-color: var(--accent); }
      .btn.ghost { color: var(--fg); background: var(--card); }
      .install-note { color: var(--muted); font-size: 0.85rem; }
      section { padding: 2.75rem 0; }
      section h2 { font-size: 1.6rem; margin: 0 0 0.35rem; }
      section > p.lede { color: var(--muted); margin-top: 0; }
      .demos { display: grid; grid-template-columns: 1fr; gap: 2rem; }
      .demo figure { margin: 0; }
      .demo img {
        width: 100%; display: block; border-radius: 10px;
        border: 1px solid var(--border); background: var(--bg2);
      }
      .demo figcaption { color: var(--muted); font-size: 0.9rem; margin-top: 0.5rem; }
      .grid {
        display: grid; gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }
      .card {
        background: var(--card); border: 1px solid var(--border);
        border-radius: 12px; padding: 1.1rem 1.25rem;
      }
      .card h3 { margin: 0 0 0.4rem; font-size: 1.02rem; }
      .card p { margin: 0; color: var(--muted); font-size: 0.92rem; }
      .channels { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
      .channel { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.15rem; }
      .channel h3 { margin: 0 0 0.5rem; font-size: 0.98rem; }
      .channel pre { margin: 0; }
      .channel small { color: var(--muted); display: block; margin-top: 0.45rem; }
      footer.site { border-top: 1px solid var(--border); padding: 1.5rem 0 2.5rem; color: var(--muted); font-size: 0.9rem; }
      footer.site .container { display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: space-between; }
      @media (max-width: 640px) {
        .hero { padding: 3rem 0 2rem; }
        nav.links a:not(:last-child) { margin-right: 0.5rem; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="container">
        <a href="./" class="wordmark">forge<span>.</span></a>
        <nav class="links">
          <a href="./docs/">Docs</a>
          <a href="https://github.com/inbesat/Munchkin-CLI">GitHub</a>
          <a href="https://github.com/inbesat/Munchkin-CLI/releases">Releases</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <section class="hero">
          <h1>The CLI coding agent<br />you can <em>own end to end</em></h1>
          <p class="tagline">
            forge is a from-scratch, open-source coding agent: event-sourced
            sessions, permission-first tool execution, provider-agnostic models,
            and a plugin architecture that makes every layer swappable.
          </p>
          <div class="cta-row">
            <a class="btn primary" href="https://github.com/inbesat/Munchkin-CLI/releases">Download</a>
            <a class="btn ghost" href="./docs/">Read the docs</a>
          </div>
          <p class="install-note">
            Prebuilt binaries on the Releases page · npm publication pending a rename
          </p>
        </section>

        <section id="demos">
          <h2>See it run</h2>
          <p class="lede">Real terminal transcripts of the actual binary — captured, not mocked.</p>
          <div class="demos">
            {demos.map((d) => (
              <div class="demo">
                <figure>
                  <img src={d.src} alt={d.title} loading="lazy" width="960" />
                  <figcaption>
                    <strong>{d.title}</strong> — {d.caption}
                  </figcaption>
                </figure>
              </div>
            ))}
          </div>
        </section>

        <section id="features">
          <h2>Highlights</h2>
          <p class="lede">What ships today — every item implemented in the monorepo.</p>
          <div class="grid">
            {features.map((f) => (
              <div class="card">
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="install">
          <h2>Install</h2>
          <p class="lede">
            Prebuilt, self-contained binaries; package-manager manifests are ready in
            <a href="https://github.com/inbesat/Munchkin-CLI/tree/main/packaging">packaging/</a>
            with tap/bucket publication pending.
          </p>
          <div class="channels">
            <div class="channel">
              <h3>GitHub Releases</h3>
              <pre><code>gh release download -R inbesat/Munchkin-CLI</code></pre>
              <small>Platform archives + checksums.txt. Recommended.</small>
            </div>
            <div class="channel">
              <h3>Homebrew</h3>
              <pre><code>brew install forge</code></pre>
              <small>Formula: packaging/homebrew/forge.rb.</small>
            </div>
            <div class="channel">
              <h3>Scoop / WinGet (Windows)</h3>
              <pre><code>scoop install forge
winget install Inbesat.Forge</code></pre>
              <small>Manifests: packaging/scoop/, packaging/winget/.</small>
            </div>
            <div class="channel">
              <h3>npm / Bun</h3>
              <pre><code>bun install -g forge</code></pre>
              <small>Package prepared; publication pending an npm rename decision.</small>
            </div>
          </div>
        </section>
      </div>
    </main>

    <footer class="site">
      <div class="container">
        <span>forge — a fully customizable CLI coding agent</span>
        <nav class="links">
          <a href="./docs/">Docs</a>
          <a href="https://github.com/inbesat/Munchkin-CLI">Source</a>
          <a href="https://github.com/inbesat/Munchkin-CLI/blob/main/docs/privacy.md">Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
